# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# Comma-separated list of allowed frontend origins (Cloudflare Pages URL,
# and your custom domain once you attach one). No trailing slashes.
CORS_ORIGINS=https://snedlink.pages.dev,https://your-custom-domain.com

# ── Firebase Admin credentials — set ONE of these two ─────────────────
# Option A: paste the ENTIRE service-account JSON file content as one line.
# Get it from Firebase Console -> Project Settings -> Service Accounts ->
# Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"capstone-2-f0d29", "...":"..."}

# Option B: instead of the above, point to a mounted file path (useful for
# some hosts / local dev). Leave FIREBASE_SERVICE_ACCOUNT_JSON blank if
# using this instead.
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/service-account.json

# Only needed if the backend reads/writes Firebase Storage.
FIREBASE_STORAGE_BUCKET=capstone-2-f0d29.firebasestorage.app

# ── Rate limiting ───────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Logging ─────────────────────────────────────────────────────────────
# morgan format: combined | common | dev | short | tiny
LOG_LEVEL=combined
